{
  "schema_version": "1.0",
  "socks_version": "1.0.0",
  "workspace_root": ".",
  "evidence_root": ".socks/evidence",
  "required_runtime": "PowerShell",
  "policy": {
    "promote_optional_failures": false,
    "promoted_optional_checks": [],
    "disabled_checks": [],
    "check_levels": {
      "git.working_tree_clean": "ADVISORY"
    },
    "conditional_checks": {},
    "check_dependencies": {},
    "warning_promotion_threshold": null,
    "composite_policies": []
  },
  "validation": {
    "required_keys": [
      "schema_version",
      "socks_version",
      "workspace_root",
      "evidence_root",
      "required_runtime"
    ]
  },
  "dependencies": {
    "runtimes": [
      { "id": "powershell", "command": "powershell", "version_args": ["-NoProfile", "-Command", "$PSVersionTable.PSVersion.ToString()"], "requirement": "REQUIRED" },
      { "id": "git", "command": "git", "version_args": ["--version"], "requirement": "REQUIRED" },
      { "id": "node", "command": "node", "version_args": ["--version"], "requirement": "ADVISORY" },
      { "id": "npm", "command": "npm", "version_args": ["--version"], "requirement": "ADVISORY" },
      { "id": "python", "command": "python", "version_args": ["--version"], "requirement": "ADVISORY" }
    ]
  },
  "configuration": {
    "required_environment": [],
    "required_settings": [],
    "placeholder_patterns": [
      "TODO",
      "CHANGEME",
      "REPLACE_ME",
      "YOUR_"
    ]
  },
  "external_connectivity": {
    "default_timeout_ms": 5000,
    "connectors": []
  },
  "plugins": {
    "root": "socks/plugins",
    "enabled": []
  }
}
